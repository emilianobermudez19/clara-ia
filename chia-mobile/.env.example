# URL del servidor web de Chía (el que corre con `npm run dev -- --host` en la carpeta raíz).
# Usa la IP de tu computadora en la red Wi-Fi, NO "localhost" (el teléfono no la ve).
# Sin esta variable, la app funciona en modo demostración (respuestas preparadas, sin red).
EXPO_PUBLIC_CHIA_API_URL=http://192.168.1.50:5173
