# Motor de IA de Chía. Sin ninguna clave, el chat funciona en modo demostración (respuestas preparadas).
# CHIA_AI_PROVIDER=mock            # forzar: mock | lovable | openai-compatible

# Opción A: gateway de Lovable
LOVABLE_API_KEY=

# Opción B: cualquier modelo con API tipo OpenAI, incluidos modelos abiertos.
# Ejemplo con Ollama en tu Mac:  ollama pull llama3.1  →
# CHIA_AI_BASE_URL=http://localhost:11434/v1
# CHIA_AI_MODEL=llama3.1
# CHIA_AI_API_KEY=
