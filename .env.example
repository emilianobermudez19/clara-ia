# ── Motor de IA de Chía ─────────────────────────────────────────────
# Basta UNA clave. Sin ninguna, el chat funciona en modo demostración.
# Si hay varias, se usa la primera en este orden (o fuerza una con CHIA_AI_PROVIDER).
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
LOVABLE_API_KEY=
# CHIA_AI_PROVIDER=groq            # openai | groq | openrouter | lovable | openai-compatible | mock
# CHIA_AI_MODEL=                   # cambia el modelo del proveedor elegido

# Modelo propio o abierto con API tipo OpenAI (Ollama, vLLM…):
# CHIA_AI_BASE_URL=http://localhost:11434/v1
# CHIA_AI_MODEL=llama3.1

# ── WhatsApp Cloud API (opcional; el webhook queda en /api/whatsapp) ──
# WHATSAPP_VERIFY_TOKEN=          # texto que tú eliges y pegas en el panel de Meta
# WHATSAPP_APP_SECRET=            # para verificar que los mensajes vienen de Meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# CHIA_PUBLIC_URL=https://tu-dominio   # para convertir las guías visuales en enlaces
